model Category {
  id        String    @id
  label     String    @unique
  title     String?
  slug      String    @unique
  icon      String
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}
