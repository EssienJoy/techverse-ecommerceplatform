model HeroSlide {
  id        String   @id @default(cuid())
  tag       String
  title     String
  subtitle  String
  imageUrl  String
  href      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model Banner {
  id          String   @id @default(cuid())
  tag         String
  title       String
  description String
  imageUrl    String
  href        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

model FlashSale {
  id        String          @id @default(cuid())
  headline  String
  endsAt    DateTime
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FlashSaleItem[]

  @@map("flash_sales")
}

model FlashSaleItem {
  id          String    @id @default(cuid())
  flashSaleId String
  productId   String    @db.Uuid
  discount    Int
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@index([productId])
  @@map("flash_sale_items")
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}
