model Saved {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @unique @db.Uuid          // 1-to-1 with User
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     SavedItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("saved_lists")
}

model SavedItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  savedId String      @db.Uuid
  saved   Saved   @relation(fields: [savedId], references: [id], onDelete: Cascade)
  productId   String      @db.Uuid
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId String?     @db.Uuid
  variation   Variations? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([savedId,  variationId]) 
  @@index([productId])
  @@map("saved_items")
}