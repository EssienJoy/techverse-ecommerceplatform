# Copy this file to .env and fill in your own values.

# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/technest?schema=public"

# Secret used to sign admin session cookies (HS256). Generate a strong value.
AUTH_SECRET="replace-with-a-long-random-secret"

# TEMP: stands in for the real login flow until it exists. Set to "false" to
# require a real admin session cookie for write endpoints.
AUTH_STUB_ADMIN="true"

# Seed defaults for the initial admin accounts.
DEFAULT_SUPER_ADMIN_EMAIL="superadmin@technest.local"
DEFAULT_ADMIN_EMAIL="admin@technest.local"
DEFAULT_ADMIN_PASSWORD="ChangeMe123!"
