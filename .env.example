# Copy this file to .env and fill in your own values.

# PostgreSQL connection string used by Prisma and the app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/technest?schema=public"

# Secret used to sign admin session JWTs (HS256). Generate a strong value.
JWT_SECRET="replace-with-a-long-random-secret"

# JWT lifetime, e.g. 90d.
JWT_EXPIRES="90d"

# Session cookie lifetime in days.
JWT_COOKIE_EXPIRES_IN="90"

# Name of the admin session cookie.
SESSION_COOKIE="technest_session"

# Cloudinary credentials used for product and content image uploads.
# Find these in the Cloudinary dashboard under Product Environment Credentials.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Folder that uploaded images are stored in. Defaults to "technest".
CLOUDINARY_UPLOAD_FOLDER="technest"
